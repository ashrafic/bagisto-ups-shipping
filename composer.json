{
    "name": "ashrafic/bagisto-ups-shipping",
    "description": "UPS shipping for Bagisto 2.x — live & negotiated rates, package consolidation, tracking, labels, and address validation via the UPS REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["bagisto", "laravel", "ups", "shipping", "checkout", "ecommerce"],
    "authors": [
        {
            "name": "Ashrafic",
            "homepage": "https://github.com/ashrafic"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.15",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ashrafic\\UpsShipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashrafic\\UpsShipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashrafic\\UpsShipping\\Providers\\UpsShippingServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
